# Track only the manuscript and curated research history.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/PLAN.md
!/BLUEPRINT.md
!/CHANGELOG.md
!/book/
!/research/
!/scripts/

# TeX products are rebuilt locally.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.log
*.out
*.pdf
*.run.xml
*.synctex.gz
*.thm
*.toc
*.zip
*.pyc
__pycache__/
.DS_Store
.env
.env.*
*.pem
*.key

# Keep bibliographic provenance, not downloaded third-party full texts.
/research/sources/*
!/research/sources/manifest.json

# Keep audit submissions and reports; machine state and raw execution logs stay local.
/research/rethlas/*
!/research/rethlas/verification/
/research/rethlas/verification/*
!/research/rethlas/verification/inputs/
!/research/rethlas/verification/results/

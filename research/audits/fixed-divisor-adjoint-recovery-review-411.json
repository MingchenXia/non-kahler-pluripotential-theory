      "checked": true,
      "direct_reconstruction": "Bounded multilinearity and closedness give T_j^2-T^2=dd((w_j-w)(T_j+T))."
    },
    {
      "id": "split-estimate",
      "checked": true,
      "direct_reconstruction": "The good set contributes8eta; bad residual difference<=2M gives8M^2*Cap_beta(E); divide by4."
    },
    {
      "id": "ordered-limits",
